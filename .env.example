# ─────────────────────────────────────────
# BASE DE DATOS
# Recomendado: https://neon.tech (gratis)
# ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vendo?sslmode=require"

# ─────────────────────────────────────────
# NEXTAUTH
# Generá: openssl rand -base64 32
# ─────────────────────────────────────────
NEXTAUTH_SECRET="tu-secreto-aleatorio-aqui"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────
# GOOGLE OAUTH (opcional)
# https://console.cloud.google.com → Credentials
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────
# CLOUDINARY — imágenes de productos
# https://cloudinary.com (gratis 25GB)
# ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────────────────────
# MERCADO PAGO — suscripciones
# https://developers.mercadopago.com
# Crear planes: npx tsx scripts/create-mp-plans.ts
# ─────────────────────────────────────────
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
MP_PLAN_STARTER_ID=""
MP_PLAN_PRO_ID=""
MP_PLAN_EXPERT_ID=""

# ─────────────────────────────────────────
# WHATSAPP BUSINESS API (opcional)
# Notificaciones automáticas a clientes
# https://developers.facebook.com/docs/whatsapp
# ─────────────────────────────────────────
WA_BUSINESS_TOKEN=""
WA_PHONE_NUMBER_ID=""

# ─────────────────────────────────────────
# SUPER ADMIN — /admin?secret=TU_SECRETO
# ─────────────────────────────────────────
ADMIN_SECRET="super-secreto-dificil-de-adivinar"

# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Vendó"

# ─────────────────────────────────────────
# EMAIL TRANSACCIONAL — Resend
# https://resend.com (gratis 3.000/mes)
# ─────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Vendó <noreply@vendo.app>"

# ─────────────────────────────────────────
# CRON JOBS
# Vercel ejecuta /api/cron/daily cada día a las 8am
# ─────────────────────────────────────────
CRON_SECRET="secreto-para-el-cron"
